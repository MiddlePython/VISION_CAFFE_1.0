<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Что вы хотите добавить?"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgCreateType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <RadioButton
            android:id="@+id/rbTypeDish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Новое блюдо"
            android:checked="true"/>
        <RadioButton
            android:id="@+id/rbTypePlate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Шаблон тары"/>
    </RadioGroup>

    <!-- Переключатель для штучного товара (виден только для блюд) -->
    <CheckBox
        android:id="@+id/cbIsPieceProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Это штучный товар (не весовой)"
        android:textSize="14sp"
        android:visibility="visible" />

    <EditText
        android:id="@+id/etNewDishName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Название (например: Булочка / Глубокая тарелка)"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/etNewDishCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Категория (Супы, Выпечка, Салаты)"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/etNewDishPrice100g"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Цена (за 100г весового ИЛИ за 1 шт. штучного)"
        android:inputType="numberDecimal" />
</LinearLayout>
